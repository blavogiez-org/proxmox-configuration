https://grafana-expose.priv.{{ domain }} {

    # que les dashboards partagés (jamais le login ni l'api admin), en vpn le temps de tester
    @vpn_public {
        remote_ip 10.8.0.0/24
        path /public-dashboards/* /api/public/* /public/*
    }
    handle @vpn_public {
        reverse_proxy 192.168.10.14:3000
    }

    # Bloqué pour tout le reste
    handle {
        respond "Accès privé uniquement en local. Votre ip {remote_host} a été refusée" 403
    }
}
